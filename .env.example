# Copy this file to .env and fill in real values. Never commit .env.

# Local Postgres connection (default matches a typical Homebrew install with
# no password, connecting as your macOS user).
DATABASE_URL=postgresql://localhost/hr_assist

# Get a free key at https://console.groq.com -> API Keys
GROQ_API_KEY=

# Get a free key at https://dashboard.cohere.com -> API Keys (used to generate
# search embeddings for policy documents and employee questions)
COHERE_API_KEY=

# Random string used to sign session cookies. Any long random value works.
SESSION_SECRET=change-me-to-a-random-string

# Model used for answer generation on Groq.
GROQ_MODEL=llama-3.3-70b-versatile
